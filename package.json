{
  "name": "@hcwhan/actions",
  "private": true,
  "version": "1.0.0",
  "description": "GitHub Actions：cache + watchdog",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cache": "node scripts/build.mjs --only cache",
    "build:watchdog": "node scripts/build.mjs --only watchdog",
    "format:ts": "node scripts/format-ts-style.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
